{
  "name": "pizzapoap",
  "version": "0.1.0",
  "description": "Automatic POAP-like attendance NFT dispenser for Pizza DAO community calls on Monad",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
